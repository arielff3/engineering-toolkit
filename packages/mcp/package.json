{
  "name": "@engineering-toolkit/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that exposes an Engineering Toolkit workspace to AI assistants",
  "type": "module",
  "bin": {
    "eng-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@engineering-toolkit/artifacts": "workspace:*",
    "@engineering-toolkit/checks": "workspace:*",
    "@engineering-toolkit/config": "workspace:*",
    "@engineering-toolkit/core": "workspace:*",
    "@engineering-toolkit/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
